# Copier vers .env.docker (non versionné) et renseigner les valeurs.

POSTGRES_USER=pilote
POSTGRES_PASSWORD=changer-moi
POSTGRES_DB=pilote_nc

APP_PORT=3000
BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Démo / test local uniquement. VIDE en production.
DEV_PASSWORD=

# Production : identifiants du client Keycloak.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
KEYCLOAK_PUBLIC_ISSUER=

# Uniquement avec --profile keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
