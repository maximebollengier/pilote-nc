{
  "name": "@pilote/nc",
  "portless": "pilote.nc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "dev": "portless ${PORTLESS_NAME:-}pilote.nc next dev",
    "deploy:prepare": "bash deploy-prepare.sh",
    "build": "prisma generate && NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=${MAX_OLD_SPACE_SIZE:-768}\" next build && node copy-assets.js && prisma migrate deploy && prisma db seed",
    "build:dev": "prisma generate && next build && node copy-assets.js && prisma migrate deploy && prisma db seed",
    "deploy:bundle": "bash deploy-bundle.sh",
    "start": "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-768} .next/standalone/apps/pilote-nc/server.js",
    "lint": "prisma generate && pnpm lint:eslint && pnpm lint:tsc",
    "lint:fix": "pnpm lint:eslint --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "lint:eslint": "eslint '{src,tests}/**/*.{ts,tsx}' --quiet",
    "lint:tsc": "pnpm exec tsc",
    "test": "vitest run",
    "test:server:unit": "vitest run",
    "test:e2e": "pnpm exec playwright test --workers=1",
    "test:e2e:seed": "./tests/seed/seed.sh",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:server": "PORTLESS_PORT=1356 portless e2e-pilote-nc dotenv -e .env.e2e -- next dev",
    "test:e2e:database:init": "dotenv -e .env.e2e -- pnpm database:init-force",
    "test:database:init": "dotenv -e .env.test -- pnpm database:init-force",
    "database:init": "prisma migrate reset",
    "database:init-force": "prisma migrate reset --force",
    "database:migration": "prisma migrate dev"
  },
  "prisma": {
    "schema": "src/database/prisma/schema.prisma",
    "seed": "ts-node src/database/prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@keycloak/keycloak-admin-client": "26.5.6",
    "@next/env": "16.1.2",
    "@prisma/client": "6.2.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "awilix": "^13.0.5",
    "clsx": "^2.1.1",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "dayjs": "^1.11.21",
    "dotenv": "16.4.5",
    "dotenv-cli": "^7.4.4",
    "dotenv-expand": "11.0.6",
    "echarts": "^6.1.0",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "nuqs": "^2.9.5",
    "pino": "^8.21.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@total-typescript/ts-reset": "^0.4.2",
    "@types/convict": "6.1.6",
    "@types/convict-format-with-validator": "6.0.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^29.1.1",
    "next-router-mock": "0.9.13",
    "nock": "^14.0.17",
    "node-mocks-http": "^1.18.1",
    "pino-pretty": "^10.3.1",
    "playwright-core": "1.59.1",
    "portless": "^0.11.1",
    "prettier": "^3.9.6",
    "prisma": "6.2.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^4.0.0"
  }
}
